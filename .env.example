# =============================================================================
# Cloud-Native Microservices E-Commerce Platform — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
# NEVER commit the resulting `.env` file — it is already in .gitignore.
# All values below are safe, non-production DEVELOPMENT defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Service ports (host + container use the same port in Docker Compose)
# -----------------------------------------------------------------------------
FRONTEND_PORT=5173
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
PAYMENT_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# -----------------------------------------------------------------------------
# Internal service URLs (used by the API Gateway to route requests)
# In Docker Compose these resolve via the service names on the shared network.
# -----------------------------------------------------------------------------
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003
PAYMENT_SERVICE_URL=http://payment-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005

# -----------------------------------------------------------------------------
# Frontend (build-time — Vite only exposes vars prefixed with VITE_)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api

# -----------------------------------------------------------------------------
# PostgreSQL
# A single shared PostgreSQL instance/database is used across services in
# local development (see docs/architecture for rationale). Each service
# connects using this same DATABASE_URL.
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_dev
POSTGRES_PASSWORD=change_me_dev_only
DATABASE_URL=postgresql://ecommerce_dev:change_me_dev_only@postgres:5432/ecommerce_db

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
PRODUCT_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=ecommerce_dev
RABBITMQ_DEFAULT_PASS=change_me_dev_only
RABBITMQ_URL=amqp://ecommerce_dev:change_me_dev_only@rabbitmq:5672
RABBITMQ_EXCHANGE=ecommerce.events

# -----------------------------------------------------------------------------
# JWT / Auth
# Generate strong random secrets for real use, e.g.:
#   openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT_SECRET=dev_only_jwt_secret_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_only_jwt_refresh_secret_change_me
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Rate limiting (API Gateway)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Notification service — email is optional in development (console logging
# is used by default). Fill these in only if wiring up real SMTP/SES.
# -----------------------------------------------------------------------------
NOTIFICATION_EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com
